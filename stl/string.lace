rib stl::string;

use stl::mem;

$public
string :: struct {
    data: *char = null,
    len: u32 = 0,
    cap: u32 = 0,
}

/// Initialize the dynamic string |s| with the given static string |str|.
$public
from (s: *string) :: (str: *char) -> void {
    let len: u64 = 0;
    until str[len] == '\0' {
        len = len + 1;
    }

    s.data = stl::mem::alloc(len + 1);

    stl::mem::copy(s.data, str, len);
    s.data[len] = '\0';
    s.len = len;
    s.cap = len + 1;
}

/// Destroy the given string |s|.
$public
destroy (s: *string) :: () -> void {
    stl::mem::free(s.data);
    s.data = null;
    s.len = 0;
    s.cap = 0;
}

/// Returns the underlying data of the given string |s|.
$public
str (s: *string) :: () -> *char {
    ret s.data;
}

/// Returns the size of the given string |s|.
$public
size (s: *string) :: () -> u32 {
    ret s.len;
}

/// Returns the capacity of the given string |s|.
$public
capacity (s: *string) :: () -> u32 {
    ret s.cap;
}

/// Test if the given string |s| is empty, i.e. contains no characters.
$public
empty (s: *string) :: () -> bool {
    ret s.len == 0;
}

/// Returns the character at position |i| of the given string |s|.
$public
at (s: *string) :: (i: u32) -> char {
    // @Todo: check index.
    ret s.data[i];
}

/// Reserve |n| bytes of the given string |s|.
$public
reserve (s: *string) :: (n: u32) -> void {
    if n <= s.cap {
        ret;
    }

    let data: *char = stl::mem::alloc(n);
    if !data {
        ret;
    }

    // Copy all bytes incl. null terminator.
    stl::mem::copy(data, s.data, s.len + 1);

    s.destroy();

    s.data = data;
    s.cap = n;
}

/// Append |other| to the back of the given string |s|.
$public
append (s: *string) :: (other: string) -> void {
    ret;    
}

load "mem.lace";

$public
stl :: space {

$public
string :: struct {
    data: *char,
    len: u64,
}

/// Initialize the dynamic string |s| with the given static string |str|.
from (s: *string) :: (str: *char) -> void {
    let len: u64 = 0;
    until str[len] == '\0' {
        len = len + 1;
    }

    s.data = alloc(len + 1);

    copy(s.data, str, len);
    s.data[len] = '\0';
    s.len = len;
}

destroy (s: *string) :: () -> void {
    free(s.data);
    s.data = null;
    s.len = 0;
}

len (s: *string) :: () -> u64 {
    ret s.len;
}

empty (s: *string) :: () -> bool {
    ret s.len == 0;
}

at (s: *string) :: (i: u64) -> char {
    // @Todo: check index.
    ret s.data[i];
}

} // space stl

utils :: space {

max :: (x: s64, y: s64) -> s64 {
    if x >= y {
        ret x;
    } else {
        ret y;
    }
}

min :: (x: s64, y: s64) -> s64 {
    if x <= y {
        ret x;
    } else {
        ret y;
    }
}

extras :: space {

foo :: () -> s64 {
    ret max(1, 42);
}

bar :: () -> s64 {
    ret utils::extras::zoo();
}

} // space extras

} // space utils

$public
main :: () -> s64 {
    ret utils::extras::bar();
}

utils :: space {

fadd :: (x: f64, y: f64) -> f64 {
    ret x + y;
}

extras :: space {

zoo :: () -> s64 {
    ret foo();
}

} // space extras

} // space utils

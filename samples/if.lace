if_stmt :: (x: bool) -> s64 {
	if x {
		ret 0;
	} else {
		ret 1;
	}
}

if_else_if_stmt :: (x: bool, y: bool) -> s64 {
	if x {
		ret 0;
	} else if y {
		ret 1;
	} else {
		ret 2;
	}
}

$[public]
main :: () -> s64 {
    let x: *s64 = null;

    if x {
        ret 0;
    } else {
        ret 42;
    }
}
